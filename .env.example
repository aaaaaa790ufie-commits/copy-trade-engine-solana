# Copy to .env and fill in. .env is gitignored — never commit a real value.
#
#   cp .env.example .env
#   python gmgn/config.py                 # verify (secrets are masked)
#   python gmgn/config.py --import-gmgn   # pull GMGN keys from ~/.config/gmgn/.env
#
# Every value below is optional except the two Telegram ones; the defaults shown are
# what the code uses. Precedence is process environment > this file > default, so
# `GMGN_ENTRY_SCORE=0.4 python gmgn/run_engine.py` still overrides it for one run.

# ============================================================================
# Credentials
# ============================================================================
# From @BotFather. If this ever leaks, revoke it with /revoke immediately.
TELEGRAM_BOT_TOKEN=""
# Your own chat id — the bot answers nobody else, and the Mini App is pinned to it.
TELEGRAM_CHAT_ID=""

# Written by `gmgn-cli config --apply <key>`; keep them here so every API credential
# lives inside the project directory. GMGN_PRIVATE_KEY is a multi-line PEM block —
# quoted values may span lines, so paste it as-is between the quotes.
GMGN_API_KEY=""
GMGN_PRIVATE_KEY=""
# GMGN_API_SECRET=""
# GMGN_WALLET_ADDRESS=""

# ============================================================================
# Paths
# ============================================================================
# SENTINEL_DB="sentinel.db"                     # engine database
# SEED_WALLETS_SOL="data/seed_wallets_sol.txt"  # manual seed wallets
# TELEGRAM_BOT_STATE="bot_state.json"           # the bot's event cursor
# SENTINEL_ENV_FILE=".env"                      # this file's own location

# ============================================================================
# Strategy — these decide what gets traded. Change deliberately.
# ============================================================================
# GMGN_CHAINS="sol"                     # only sol is verified to work
# GMGN_ENTRY_SCORE="1.0"                # one 90%+ wallet, or two 80-90%, or four 70-80%
# PAPER_BUDGET_SOL="0.1"                # starting balance, first run only
# PAPER_TRADE_SIZE_SOL="0.025"          # stake per entry
# GMGN_CLUSTER_WINDOW_SECONDS="1800"    # how far back a buy still counts
# GMGN_COOLDOWN_SECONDS="420"           # re-entry lockout after an exit

# --- Exits ---
# HARD_STOP_PCT="45"                    # emergency exit, % below entry
# TRAILING_ACTIVATE_PCT="25"            # gain at which the trailing stop arms
# TRAILING_DISTANCE_PCT="15"            # how far below the peak it sits
# GMGN_MAX_HOLD_SECONDS="3600"          # 1h, then close regardless

# --- Weighting ---
# The ladder lives in paper_engine.WEIGHT_TIERS, not here, because the panel and the
# bot build their win-rate buckets from it:
#   90-100% -> 1.0    80-90% -> 0.5    70-80% -> 0.25    60-70% -> 0.0625    50-60% -> 0.03125
# A wallet at or above this carries a full ENTRY_SCORE, so its buy opens a position on
# its own. It also gates the MISSED report — a signal this strong that could not be
# acted on (cooldown, already held, no funds) is worth knowing about.
# GMGN_ELITE_WINRATE="0.90"
# GMGN_ELITE_CALLOUTS_MAX="10"          # cap on MISSED reports per cycle

# ============================================================================
# Engine loop
# ============================================================================
# GMGN_POLL_SECONDS="15"                # feed poll interval
# Trades requested per poll. GMGN caps this endpoint at 100 server-side — asking for
# 150, 200 or 500 all return exactly 100 — so raising it has no effect.
# GMGN_FEED_LIMIT="100"
# GMGN_CLI_TIMEOUT="45"                 # per gmgn-cli call
# GMGN_MAX_CYCLE_FAILURES="5"           # consecutive failures before exiting for a restart
# How stale a heartbeat may be before /status and the panel call the engine stopped.
# The effective threshold is max(this, GMGN_POLL_SECONDS * 6).
# GMGN_ALIVE_GRACE_SECONDS="120"
# A cycling loop and a working engine are different things. If the feed has returned
# nothing for this long, /status and the panel say "нет данных" rather than LIVE.
# The effective threshold is max(this, GMGN_POLL_SECONDS * 6).
# GMGN_FEED_STALE_SECONDS="300"
# How far back /weights and the panel look when reporting how close the engine has
# come to an entry. Answers "is the market quiet, or is my threshold unreachable?"
# GMGN_SIGNAL_HISTORY_HOURS="24"
# GMGN_PRICE_TTL_SECONDS="60"           # mark price cache lifetime
# GMGN_PRICE_CACHE_MAX="5000"           # entries before the cache evicts

# Wallet bookkeeping is background work. Keep GMGN_MAINTENANCE_SECONDS well above
# GMGN_POLL_SECONDS: stop-loss checks must never wait behind a stats sweep.
# GMGN_MAINTENANCE_SECONDS="600"
# GMGN_STATS_BATCH_MAX="6"              # stats round-trips per sweep
# GMGN_STATS_TTL_SECONDS="3600"         # how long a win rate stays fresh
# GMGN_ZERO_WINRATE_TTL_SECONDS="3600"  # drop never-scored wallets after this

# A position whose token stops being quotable never closes and its stake stays
# locked; the engine raises a STUCK event rather than guessing what it is worth.
# GMGN_STUCK_AFTER_SECONDS="7200"       # default: 2x max hold
# GMGN_STUCK_REMIND_SECONDS="21600"     # repeat interval for that alert

# A feed that returns nothing is journalled as an ERROR so it reaches Telegram and the
# panel, not just the console — the heartbeat keeps ticking either way, so without this
# the engine reads LIVE while fetching nothing. Repeat interval for that alert:
# GMGN_FEED_FAIL_REMIND_SECONDS="900"

# ============================================================================
# Telegram bot
# ============================================================================
# TELEGRAM_PUSH_BATCH="20"              # events pushed per poll
# TELEGRAM_CATCHUP_LIMIT="15"           # above this backlog, send one summary instead
# Wallet-pool bookkeeping fires on every new address — ~60 messages a day against ~8
# entries and exits, which buries them. At most one WALLET notification per this many
# seconds; the journal, the panel feed and /wallets are unaffected. 0 pushes every one.
# TELEGRAM_WALLET_PUSH_SECONDS="3600"

# ============================================================================
# Mini App
# ============================================================================
WEBAPP_HOST="127.0.0.1"
WEBAPP_PORT="8770"
# Public HTTPS origin. Telegram only opens Mini Apps over https, so the button
# appears only once this is set — and setting it turns on initData verification.
# The supervisor fills this in automatically when run with --tunnel.
# WEBAPP_PUBLIC_URL="https://your-tunnel.example"
# WEBAPP_REQUIRE_AUTH="1"               # defaults on whenever the panel is reachable
#                                       # from outside this machine, including 0.0.0.0
# WEBAPP_INITDATA_MAX_AGE="86400"       # reject signatures older than this
# WEBAPP_REQUEST_TIMEOUT="30"           # drop half-open connections

# ============================================================================
# Tunnel (supervisor.py --tunnel)
# ============================================================================
# TUNNEL_PROVIDER="auto"                # auto | cloudflared | pinggy
# TUNNEL_PROTOCOLS="quic,http2"         # cloudflared transports to try, in order
# TUNNEL_START_TIMEOUT="45"             # wait for the provider to report a URL
# TUNNEL_PROBE_TIMEOUT="30"             # then wait for that URL to actually answer
# PINGGY_HOST="a.pinggy.io"

# ============================================================================
# mass_discovery.py — offline wallet collection, not used by the engine loop
# ============================================================================
# GMGN_DISCOVERY_CLI_TIMEOUT="60"
# GMGN_MIN_CLUSTER_WALLETS="3"
# GMGN_MIN_WINRATE="0.70"
# GMGN_MIN_BUYS_30D="10"
# GMGN_MIN_REALIZED_PROFIT_USD="0"

# ============================================================================
# pumpfun_discovery.py — offline pump.fun wallet harvester, not used by engine
# ============================================================================
# PUMPFUN_API_BASE="https://frontend-api-v3.pump.fun"  # pump.fun API origin
# PUMPFUN_AUTH_TOKEN=""                                 # optional JWT for fewer throttles
# PUMPFUN_USER_AGENT="Mozilla/5.0 (compatible; sentinel-research/1.0)"
# PUMPFUN_HTTP_TIMEOUT="25"                             # per-request timeout
# PUMPFUN_REQUEST_DELAY="0.25"                          # pause between API calls
# PUMPFUN_MAX_RETRIES="4"                               # backoff attempts per call
# PUMPFUN_MIN_TRADE_SOL="0.05"                          # ignore dust trades
# PUMPFUN_TRADES_PAGE="200"                             # trades per API page
# PUMPFUN_TRADES_MAX_PAGES="12"                         # max pages per mint
# PUMPFUN_COINS_PAGE="50"                               # coins per API page
# PUMPFUN_MIN_WINRATE="0.50"                            # GMGN 30d win-rate gate
# PUMPFUN_MIN_MINTS="2"                                 # distinct mints before verifying
# PUMPFUN_MIN_TRADES="3"                                # harvested trades before verifying
# PUMPFUN_MIN_30D_TRADES="5"                            # reject lucky one-trade wallets
# PUMPFUN_STATS_BATCH="10"                              # GMGN stats per batch
# PUMPFUN_STATS_DELAY="0.35"                            # pause between GMGN batches
# PUMPFUN_RECHECK_SECONDS="86400"                       # re-verify accepted wallets
