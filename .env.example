# Copy to .env and fill in. .env is gitignored — never commit a real value.
#
#   cp .env.example .env
#   python gmgn/config.py                 # verify (secrets are masked)
#   python gmgn/config.py --import-gmgn   # pull GMGN keys from ~/.config/gmgn/.env

# --- Telegram ---------------------------------------------------------------
# From @BotFather. If this ever leaks, revoke it with /revoke immediately.
TELEGRAM_BOT_TOKEN=""
# Your own chat id — the bot answers nobody else.
TELEGRAM_CHAT_ID=""

# --- GMGN API ---------------------------------------------------------------
# Written by `gmgn-cli config --apply <key>`; keep them here so every API
# credential lives inside the project directory.
GMGN_API_KEY=""
GMGN_PRIVATE_KEY=""

# --- Mini App ---------------------------------------------------------------
WEBAPP_HOST="127.0.0.1"
WEBAPP_PORT="8770"
# Public HTTPS origin of the panel. Telegram only opens Mini Apps over https, so
# the button appears only once this is set. Example:
#   cloudflared tunnel --url http://127.0.0.1:8770
# WEBAPP_PUBLIC_URL="https://your-tunnel.trycloudflare.com"
# Signature checking turns on automatically whenever WEBAPP_PUBLIC_URL is set.
# WEBAPP_REQUIRE_AUTH="1"

# --- Engine (optional overrides) --------------------------------------------
# GMGN_CHAINS="sol"
# GMGN_POLL_SECONDS="15"
# GMGN_ENTRY_SCORE="0.25"
# PAPER_BUDGET_SOL="0.1"
# PAPER_TRADE_SIZE_SOL="0.025"
# HARD_STOP_PCT="45"
# TRAILING_ACTIVATE_PCT="25"
# TRAILING_DISTANCE_PCT="15"
# GMGN_MAX_HOLD_SECONDS="21600"
# How often the slow wallet-bookkeeping pass runs (seconds). Keep it well above
# GMGN_POLL_SECONDS so stop-loss checks are never delayed by stats API calls.
# GMGN_MAINTENANCE_SECONDS="600"
# GMGN_STATS_BATCH_MAX="6"
